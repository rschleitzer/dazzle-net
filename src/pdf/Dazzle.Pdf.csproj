<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Dazzle.Pdf</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>CS8632;CS0109;CS0414</NoWarn>
    <LangVersion>preview</LangVersion>

    <!-- NuGet Package -->
    <PackageId>Dazzle.Pdf</PackageId>
    <Version>0.9.0</Version>
    <Authors>Ralf Schleitzer</Authors>
    <Description>DSSSL-to-PDF processor using OpenJade: sets the pages itself and writes them with PDFsharp. Includes table support and a clean DssslProcessor API.</Description>
    <PackageTags>dsssl;openjade;pdf;pdfsharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/rschleitzer/dazzle-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- OpenJadeSource names a checkout of openjade-net to build against instead of the packages
       (dotnet build -p:OpenJadeSource=../openjade-net), for changes to both before a release -->
  <ItemGroup Condition="'$(OpenJadeSource)' == ''">
    <PackageReference Include="OpenSP" Version="1.5.5" />
    <PackageReference Include="OpenJade" Version="1.5.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(OpenJadeSource)' != ''">
    <ProjectReference Include="$(OpenJadeSource)\src\OpenSP\OpenSP.csproj" />
    <ProjectReference Include="$(OpenJadeSource)\src\OpenJade\OpenJade.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="sgml\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
